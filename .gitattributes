# Hash-pinned bridge source must retain byte-identical LF line endings on every host.
/bridge/java/**/*.java text eol=lf

# Declaration fixtures are compared as text and should remain platform-neutral.
/bridge/abi/*.txt text eol=lf

# Patch context includes a single space for empty source lines, not code defects.
# Keep published patch SHA-256 fingerprints stable across Windows/WSL checkouts.
/platform/systemui/*.patch text eol=lf -whitespace
/platform/checkpoints/**/*.patch text eol=lf -whitespace
/platform/checkpoints/**/manifest.json text eol=lf
# Preserve the byte-identical repo manifest snapshot, including blank-line spaces.
/platform/checkpoints/**/base-manifest.xml text eol=lf -whitespace

# These helper assets are hash-pinned; shell scripts also require Unix endings.
/tools/**/*.smali text eol=lf
/tools/**/*.sh text eol=lf

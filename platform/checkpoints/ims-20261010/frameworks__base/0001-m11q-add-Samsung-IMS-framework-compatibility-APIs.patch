+        };
+        protected static final String[] rcsServices = {
+                OPTIONS, PRESENCE, IM, FT, FT_HTTP, SLM, IS, VS, EUC, GLS, PROFILE,
+                EC, CHATBOT_COMMUNICATION, PLUG_IN, LASTSEEN
+        };
+        private static final String[] mImsFeatureList = {

+    private void loadFeatureFile() {
+        try (FileInputStream input = new FileInputStream(FEATURE_FILE)) {
+            byte[] file = readAll(input);
+            byte[] xml = isPlainXml(file) ? file : decompress(decode(file));
+            XmlPullParser parser = Xml.newPullParser();
